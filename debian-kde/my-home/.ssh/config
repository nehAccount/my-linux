Host *
 ServerAliveInterval 60

# Default github account: nehAccount
Host github-nehAccount
   HostName github.com
   IdentityFile ~/.ssh/id_nermin
   IdentitiesOnly yes
   
# Other github account: bnpz
Host github-bnpz
   HostName github.com
   IdentityFile ~/.ssh/bnp-admin
   IdentitiesOnly yes 

# bnp.ba hosting: bnpze
Host bnp-sftp
   HostName dedi5675.your-server.de
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/bnp-admin
   IdentitiesOnly yes


# bnp-zenica.com on Linode
Host bnp-zenica.com
   HostName bnp-zenica.com
   IdentityFile ~/.ssh/id_bnpz
   Port 7222
   IdentitiesOnly yes

# cloud.shareloc.dev
Host my-cloud-nermin
   HostName cloud.shareloc.dev
   User nermin
   Port 7987
   IdentityFile ~/.ssh/id_rsa
   IdentitiesOnly yes

# cloud.shareloc.dev
Host my-cloud-root
   HostName cloud.shareloc.dev
   User root
   Port 7987
   IdentityFile ~/.ssh/id_rsa
   IdentitiesOnly yes