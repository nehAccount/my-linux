Host *
 ServerAliveInterval 60

# Default github account: nehAccount
Host github-nehAccount
   HostName github.com
   IdentityFile ~/.ssh/id_neh
   IdentitiesOnly yes

# Other github account: bnpz
Host github-bnpz
   HostName github.com
   IdentityFile ~/.ssh/id_bnpz
   IdentitiesOnly yes

# bnp.ba hosting: bnpze
Host bnp-sftp
   HostName dedi5675.your-server.de
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/id_bnpz
   IdentitiesOnly yes

# bnp-zenica.com on Linode
Host bnp-zenica.com
   HostName bnp-zenica.com
   IdentityFile ~/.ssh/id_bnpz
   IdentitiesOnly yes

# app.bnp-zenica.com on Linode
Host app.bnp-zenica.com
   HostName app.bnp-zenica.com
   IdentityFile ~/.ssh/id_bnpz
   IdentitiesOnly yes

# cloud.shareloc.dev | nermingk.cloud
Host my-cloud-nermin
   HostName nermingk.cloud
   User nermin
   Port 7987
   IdentityFile ~/.ssh/id_rsa
   IdentitiesOnly yes

# cloud.shareloc.dev | nermingk.cloud
Host my-cloud-root
   HostName nermingk.cloud
   User root
   Port 7987
   IdentityFile ~/.ssh/id_rsa
   IdentitiesOnly yes
