{
    "custom/appmenuicon": {
        "format": "",
        "on-click": "rofi -show drun -replace",
        "on-click-right": "~/dotfiles/hypr/scripts/keybindings.sh",
        "tooltip": false
    },
    "clock": {
        "format": "{:%b %d | %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "custom/weather": {
        "exec": "~/dotfiles/waybar/scripts/get_weather.sh Zenica",
        "on-click": "~/dotfiles/waybar/scripts/get_weather.sh Zenica",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "interval": 900
    },
    "group/quicklinks": {
        "orientation": "horizontal",
        "modules": [
            "custom/wallpaper",
            "custom/phpstorm",
            "custom/filemanager",
            "custom/browser"
        ]
    },
    "custom/wallpaper": {
        "format": "",
        "on-click": "~/dotfiles/hypr/scripts/wallpaper.sh select",
        "on-click-right": "~/dotfiles/hypr/scripts/wallpaper.sh",
        "tooltip": "Change Wallpaper"
    },
    "custom/phpstorm": {
        "format": " ",
        "on-click": "/usr/bin/phpstorm",
        "tooltip-format": "PhpStorm"
    },
    "custom/filemanager": {
        "format": "",
        "on-click": "~/dotfiles/.settings/filemanager.sh",
        "tooltip": false
    },
    "custom/browser": {
        "format": "",
        "on-click": "~/dotfiles/.settings/browser.sh",
        "tooltip": false
    },

    "hyprland/workspaces" : {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    },
    "custom/updates": {
        "format": "  {}",
        "tooltip-format": "{}",
        "escape": true,
        "return-type": "json",
        "exec": "~/dotfiles/scripts/my-updates.sh",
        "restart-interval": 60,
        "on-click": "alacritty -e ~/dotfiles/scripts/installupdates.sh",
        "tooltip": false
    },
    "bluetooth": {
        "format": "",
        "format-connected": "",
        "format-connected-battery": "",
        "tooltip-format": "{controller_alias}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        "interval": 30,
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "{icon}",
        "format-muted": " ",
        "tooltip-format": "{volume}%",
        "format-icons": {
            "default": [" "]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": " ",
        "format-ethernet": "",
        "format-disconnected": " ",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "No network",
        "max-length": 50,
        "on-click": "~/dotfiles/.settings/networkmanager.sh"
    },
    "battery": {
        "interval": 5,
        "states": {
            "warning": 33,
            "critical": 15
        },
        "format": "{icon}   {capacity}%",
        "format-charging": "  {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{time}"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "show-passive-items": true
    },
    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    }
}