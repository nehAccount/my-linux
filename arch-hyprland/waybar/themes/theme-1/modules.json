{
    "custom/appmenuicon": {
        "format": "",
        "on-click": "rofi -show drun -replace",
        "on-click-right": "~/dotfiles/hypr/scripts/keybindings.sh",
        "tooltip": false
    },
    "clock": {
        "format": "{:%b %d | %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "bluetooth": {
        "format": "",
        "format-connected": "",
        "format-connected-battery": "",
        "tooltip-format": "{controller_alias}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        "interval": 30,
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "{icon}",
        "format-muted": " ",
        "tooltip-format": "{volume}%",
        "format-icons": {
            "default": [" "]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": " ",
        "format-ethernet": "",
        "format-disconnected": " ",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "No network",
        "max-length": 50,
        "on-click": "~/dotfiles/.settings/networkmanager.sh"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "show-passive-items": true
    },
    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    }
}