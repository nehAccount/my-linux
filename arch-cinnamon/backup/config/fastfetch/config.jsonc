{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": "->   ",
    "color": {
      "separator": "1", // Bold
    },
    "constants": ["───────────────────────────"],
    "key": {
      "type": "both",
      "paddingLeft": 4,
    },
  },
  "modules": [
    {
      "type": "title",
      "format": "                             {user-name-colored}{at-symbol-colored}{host-name-colored}",
    },
    "break",
    {
      "type": "custom",
      "format": "┌{$1} {#1}System Information{#} {$1}┐",
    },
    "break",
    {
      "key": "Kernel       ",
      "keyColor": "magenta",
      "type": "kernel",
    },
    {
      "key": "Packages     ",
      "keyColor": "cyan",
      "type": "packages",
    },
    {
      "key": "WM           ",
      "keyColor": "blue",
      "type": "wm",
    },
    {
      "key": "DE           ",
      "keyColor": "green",
      "type": "de",
    },
    {
      "key": "Shell        ",
      "keyColor": "yellow",
      "type": "shell",
    },
    {
      "key": "Terminal     ",
      "keyColor": "red",
      "type": "terminal",
    },
    {
      "key": "Memory       ",
      "keyColor": "magenta",
      "type": "memory",
    },
    {
      "key": "Disk         ",
      "type": "disk",
      "keyColor": "green",
    },
    {
      "key": "Local IP     ",
      "keyColor": "red",
      "type": "localip",
      "compact": true,
    },
    {
      "key": "Public IP    ",
      "keyColor": "cyan",
      "type": "publicip",
      "timeout": 1000,
    },
    "break",
    {
      "type": "custom",
      "format": "└{$1}────────────────────{$1}┘",
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 34,
      "symbol": "circle",
    },
  ],
}
