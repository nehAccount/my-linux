# to change font exec: kitten choose-fonts
# BEGIN_KITTY_FONTS
font_family      family="FiraCode Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS

font_size 12.0

# window 
remember_window_size  yes
background_opacity 0.9
window_padding_width 16
# window_logo_path /home/nermin/.config/kitty/distro.svg

# cursor - no-cursor => disable shell cursor modification
shell_integration no-cursor
# block | beam | underline
cursor_shape underline
