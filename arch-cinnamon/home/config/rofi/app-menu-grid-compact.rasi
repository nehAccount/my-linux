@import "~/.cache/wal/colors-rofi-pywal.rasi"
@import "~/.config/rofi/share/font.rasi"
@import "~/.config/rofi/share/globals.rasi"

* {
	background-color: transparent;
	text-color:       white;
}

configuration {
	modes: "drun";
	show-icons: true;
	drun-display-format: "{name}";
	display-drun: "Find";

  timeout {
      action: "kb-cancel";
      delay:  0;
  }
}
 
window {
	fullscreen:       false;
	location:   north;
	 margin:                       80px;
    //anchor:   south west;
	background-color: @background;
	padding:          0.5em;
	children:         [ wrap, listview-split];
	spacing:          0.5em;
	border-color:     @hover;
	border:           1px;
	border-radius:    1em;
}


/** We add an extra child to this is PREVIEW=true */
listview-split {
  orientation: horizontal;
  spacing: 0.1em;
  children: [listview];
}

/** SEARCH BAR **/
wrap {
	expand: false;
	orientation: vertical;
	children: [ inputbar, message ];
	border: 1px;
	background-color: @hover;
	border-color: @color2;
	border-radius: 0.5em;
	padding: 0.2em;
}
inputbar {
	spacing: 0.4em;
	padding: 0.2em;
	children: [ icon-ib, entry ];

}
icon-ib {
	expand: false;
	filename: "search";
	vertical-align: 0.5;
	horizontal-align: 0.5;
	size: 1em;
}

entry {
	placeholder: "";
	placeholder-color: grey;
	vertical-align: 0.5;
	font: "SF Pro Rounded Light 14";
	color: @foreground;
}
message {
	background-color: transparent;
	border: 0px;
	//padding: 0.4em;
	//spacing: 0.4em;
}

listview {
	flow: horizontal;
	fixed-columns: true;
	columns: 5;
	lines: 3;
	spacing: 0.5em;
	border: 0px;
	background-color: transparent;
}

element {
	orientation: vertical;
	padding: 1em;
	border: 0px;
	border-radius: 0.5em;
    children: [element-icon, element-text ];
}
element-icon {
	//size: calc(((100% - 8em) / 7 ));
	size: 3em;
	horizontal-align: 0.5;
	vertical-align: 0.5;
}
element-text {
	horizontal-align: 0.5;
	vertical-align: 0.5;
    padding: 0.2em;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            transparent;
    text-color:                  @foreground;
    border-color:               @hover;
    border: 1px;
}

scrollbar {
    width:        0.4em ;
    padding:      0;
    handle-width: 0.4em ;
    border:       0;
    handle-color: @hover;
}

/**
 * Launching rofi with environment PREVIEW set to true
 * will split the screen and show a preview widget.
 */
@media ( enabled: env(PREVIEW, false)) {
  /** preview widget */
  icon-current-entry {
    expand:          true;
    size:            80%;
  }
  listview-split {
    children: [listview, icon-current-entry];
  }
  listview {
  columns: 4;
  }

}

@media ( enabled: env(NO_IMAGE, false)) {
	listview {
		columns: 1;
		spacing: 0.4em;
	}
	element {
		children: [ element-text ];
	}
	element-text {
		horizontal-align: 0.0;
	}
}
